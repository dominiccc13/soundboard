{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "C/C++: cl.exe build active file",
			"command": "cl.exe",
			"args": [
				"/Zi",
				"/EHsc",
				"/nologo",
				"/std:c++17",
				"/Fe${workspaceFolder}\\soundboard.exe",
				"${workspaceFolder}\\Main\\Main.cpp",
				"${workspaceFolder}\\Main\\WasapiMixer.cpp",
				"${workspaceFolder}\\Main\\Utils.cpp",
				"${workspaceFolder}\\Main\\Tray.cpp",
				"${workspaceFolder}\\Resources\\resource.res",
				"ole32.lib",
				"user32.lib",
				"/link",
				"/SUBSYSTEM:WINDOWS",
				"/ENTRY:mainCRTStartup"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$msCompile"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "compiler: cl.exe"
		}
	]
}